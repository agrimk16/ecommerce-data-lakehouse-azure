{
  "name": "ds_ecommerce_gold_delta",
  "type": "Microsoft.DataFactory/factories/datasets",
  "properties": {
    "description": "Gold layer in ADLS Gen2 — business-level star schema in Delta format (written by Databricks)",
    "linkedServiceName": {
      "referenceName": "ls_adls_ecommerce_datalake",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "folderPath": {
        "type": "string"
      }
    },
    "annotations": ["gold", "delta", "star-schema"],
    "type": "Parquet",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "folderPath": {
          "value": "@dataset().folderPath",
          "type": "Expression"
        },
        "fileSystem": "gold"
      }
    }
  }
}
