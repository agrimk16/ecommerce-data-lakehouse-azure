    "annotations": ["schedule-trigger", "ecommerce", "daily"],
    "runtimeState": "Stopped",
    "type": "ScheduleTrigger",
    "typeProperties": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2024-01-01T00:30:00Z",
        "timeZone": "India Standard Time"
      }
    },
    "pipelines": [
      {
        "pipelineReference": {
          "referenceName": "pl_master_pipeline",
          "type": "PipelineReference"
        }
      }
    ]
  }
}
